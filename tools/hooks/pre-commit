#!/bin/sh
# Stopper commit av filer som kan inneholde ekte elevdata (DPIA T6, IF-04).
# Aktiveres én gang med:  git config core.hooksPath tools/hooks

blokkert=$(git diff --cached --name-only --diff-filter=ACMR | grep -v '^testdata/' | grep -Ei '\.(xlsx|xls|xlsm|csv|ods|pdf)$|SFO-backup-.*\.json$')

if [ -n "$blokkert" ]; then
  echo ""
  echo "STOPP: Disse filene kan inneholde elevdata og skal ikke i repoet:"
  echo "$blokkert" | sed 's/^/  - /'
  echo ""
  echo "Fjern dem fra commit med:  git restore --staged <fil>"
  echo "Fiktive testdata hører hjemme i testdata/."
  exit 1
fi

# Stopper commit hvis sikkerhetsregelen (CSP) er svekket eller det er lagt inn kode som kan sende data.
if command -v node >/dev/null 2>&1; then
  if ! node --test tests/personvern.test.js >/dev/null 2>&1; then
    echo ""
    echo "STOPP: Personverntestene feiler. Sikkerhetsregelen (CSP) eller nettverkskode er endret."
    echo "Se hva som feiler med:  node --test tests/personvern.test.js"
    echo "Endringer her krever ny vurdering i DPIA-en."
    exit 1
  fi
fi

# ESLint, hvis det er installert (npm install). Stopper commit ved feil i koden.
if [ -x node_modules/.bin/eslint ]; then
  if ! node_modules/.bin/eslint . >/dev/null 2>&1; then
    echo ""
    echo "STOPP: ESLint fant feil. Se hva med:  npm run lint"
    exit 1
  fi
fi

exit 0
