{
  "name": "sfo-appen",
  "version": "0.12.2",
  "private": true,
  "description": "Lokal webapp (PWA) for inn- og utsjekk, fravær og telling på SFO. Ingen data sendes over nett.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "sjekk": "npm run lint && npm test",
    "serve": "node tools/serve.js",
    "testdata": "node tools/lag-testdata.js",
    "hooks": "git config core.hooksPath tools/hooks",
    "e2e:installer": "playwright install chromium",
    "e2e": "node tools/e2e-test.cjs",
    "e2e:ettermiddag": "node tools/e2e-ettermiddag.cjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright": "1.63.0"
  }
}
